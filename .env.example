GEMINI_API_KEY=your_api_key_here

# Gemini 무료 티어 일일 할당량(하루 20회) 소진 시 자동 대체되는 모델
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=

# (선택) 브이월드(VWorld) - 주소 기반 용도지역 자동 조회용. 없으면 lookup_land_zone이
# 사용자에게 직접 물어보는 것으로 대체됨. 발급: https://www.vworld.kr/dev/v4api.do
VWORLD_API_KEY=

# (선택) 건축HUB 건축물대장정보 서비스 - 기존 건물 표제부(용도ᆞ연면적ᆞ층수 등)
# 자동 조회용. 없으면 lookup_building_ledger가 사용자에게 직접 물어보는 것으로 대체됨.
# 발급: https://www.data.go.kr (국토교통부_건축물대장정보 서비스 활용신청)
ARCHHUB_SERVICE_KEY=
ARCHHUB_LEDGER_ENDPOINT=https://apis.data.go.kr/1613000/BldRgstHubService
